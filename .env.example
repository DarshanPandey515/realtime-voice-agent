# Copy this file to .env and fill in your API keys.

# AssemblyAI — real-time speech-to-text
ASSEMBLYAI_API_KEY=

# Groq — LLM inference (used with pydantic-ai)
GROQ_API_KEY=

# ElevenLabs — text-to-speech
ELEVENLABS_API_KEY=

# ASR language code (e.g., "en" for English, "es" for Spanish)
# AssemblyAI auto-detects by default, but explicit setting prevents misdetection
ASR_LANGUAGE_CODE=en

# VAD (Voice Activity Detection) settings for barge-in
# Higher threshold = less sensitive to background noise (range 0.0-1.0)
# Higher onset_frames = requires more consecutive speech frames to trigger
VAD_THRESHOLD=0.7
VAD_ONSET_FRAMES=3

# Audio device indices (optional, use -1 for default)
# Run: uv run python -c "import pyaudio; p=pyaudio.PyAudio(); [print(f'{i}: {p.get_device_info_by_index(i)[\"name\"]}') for i in range(p.get_device_count())]"
INPUT_DEVICE_INDEX=-1
OUTPUT_DEVICE_INDEX=-1